{
  "name": "atlas-web",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "description": "Atlas \u2014 AI Engineering Workspace frontend (rewrite from the Figma E2E delivery 0md9BEFI1rU0aRAvf98TWO)",
  "scripts": {
    "import:design": "node tools/import-design.mjs && node tools/import-native-states.mjs",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:review": "npm run typecheck && vite build --mode review --outDir dist-review",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build",
    "release": "node tools/release.mjs",
    "worker:staging": "node tools/staging-worker.mjs",
    "preview:review": "vite preview --outDir dist-review --host 127.0.0.1 --port 4174 --strictPort",
    "e2e:review": "playwright test -c playwright.review.config.ts",
    "test:tooling": "node --test tools/tests/*.test.mjs",
    "verify": "node tools/verify.mjs local",
    "verify:staging": "node tools/verify.mjs staging"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.104.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.16",
    "idb": "^8.0.3",
    "lucide-react": "^1.52.0",
    "marked": "^18.0.14",
    "monaco-editor": "^0.55.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "y-monaco": "^0.1.6",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.0.0",
    "playwright-core": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
