{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": false
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "e2e",
    "playwright.review.config.ts",
    "playwright.staging.config.ts"
  ]
}
